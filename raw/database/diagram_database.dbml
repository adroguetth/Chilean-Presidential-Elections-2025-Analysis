// Chile Elections DB — DBML schema

Table dim_commune {
  commune_id integer [pk, increment]
  region_code text
  region_name text [not null]
  region_order integer
  macrozone text
  macrozone_order integer
  circunscripcion_senatorial text
  distrito_electoral text
  commune_name text [not null]
  population integer
  province text
  regional_capital integer [default: 0, note: '1 = commune is regional capital']
  provincial_capital integer [default: 0, note: '1 = commune is provincial capital']

  indexes {
    commune_name [name: 'idx_dim_commune_name']
    region_code [name: 'idx_dim_commune_region']
    macrozone [name: 'idx_dim_commune_macrozone']
    province [name: 'idx_dim_commune_province']
  }

  Note: 'Geographic and administrative dimension of Chile\'s 346 communes'
}

Table fact_first_round_2021 {
  id integer [pk, increment]
  commune_id integer [ref: > dim_commune.commune_id]
  artes_votes integer
  artes_pct real
  boric_votes integer
  boric_pct real
  enriquez_ominami_votes integer
  enriquez_ominami_pct real
  kast_votes integer
  kast_pct real
  parisi_votes integer
  parisi_pct real
  provoste_votes integer
  provoste_pct real
  sichel_votes integer
  sichel_pct real
  blank_votes integer
  blank_pct real
  casted_votes integer
  casted_pct real
  null_votes integer
  null_pct real

  indexes {
    commune_id [name: 'idx_fr2021_commune']
  }

  Note: '2021 presidential first round results by commune'
}

Table fact_second_round_2021 {
  id integer [pk, increment]
  commune_id integer [ref: > dim_commune.commune_id]
  boric_votes integer
  boric_pct real
  kast_votes integer
  kast_pct real
  blank_votes integer
  blank_pct real
  casted_votes integer
  casted_pct real
  null_votes integer
  null_pct real

  indexes {
    commune_id [name: 'idx_sr2021_commune']
  }

  Note: '2021 presidential second round results by commune'
}

